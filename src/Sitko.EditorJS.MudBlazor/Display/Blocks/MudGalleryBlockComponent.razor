@inherits GalleryBlockComponent<TImageData>
@typeparam TImageData

@if (Block.Data.Style == "slider")
{
    <MudCarousel AutoCycle="true" AutoCycleTime="TimeSpan.FromSeconds(2)" ItemsSource="@(Block.Data.Files.ToList())">
        <ItemTemplate>
            <img src="@context.Url" alt="Image: @context.FileName"/>
        </ItemTemplate>
    </MudCarousel>
}
else
{
    foreach (var file in Block.Data.Files)
    {
        <div class="responsive">
            <div class="gallery">
                <img src="@file.Url" alt="Image: @file.FileName">
            </div>
        </div>
    }

    <div class="clearfix"></div>
}

