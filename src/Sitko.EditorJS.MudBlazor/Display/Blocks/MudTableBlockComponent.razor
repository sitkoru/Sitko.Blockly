@using global::MudBlazor
@inherits TableBlockComponent

@if (Block.Data.Content != null)
{
    <MudTable Items="Block.Data.Content">
        <HeaderContent>
            @if (Block.Data.WithHeadings)
            {
                foreach (var items in Block.Data.Content)
                {
                    foreach (var item in items)
                    {
                        <MudTh>@item</MudTh>
                    }
                    break;
                }
            }
        </HeaderContent>
        <RowTemplate>
            @if (Block.Data.WithHeadings)
            {
                if (Block.Data.Content[0] != context)
                {
                    foreach (var item in context)
                    {
                        <MudTd>@item</MudTd>
                    }
                }
            }
            else
            {
                foreach (var item in context)
                {
                    <MudTd>@item</MudTd>
                }
            }

        </RowTemplate>
    </MudTable>

