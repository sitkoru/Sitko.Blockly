@using global::MudBlazor
@inherits TableBlockComponent

@if (Block.Data.Content != null)
{
    <table>
        @if (Block.Data.WithHeadings)
        {
            <thead>
            @foreach (var items in Block.Data.Content)
            {
                foreach (var item in items)
                {
                    <MudTh>@item</MudTh>
                }
                break;
            }
            </thead>
            <tbody>
            @foreach (var items in Block.Data.Content.Skip(1))
            {
                <tr>
                    @foreach (var item in items)
                    {
                        <MudTd>@item</MudTd>
                    }
                </tr>
            }
            </tbody>
        }
        else
        {
            foreach (var items in Block.Data.Content)
            {
                <tr>
                    @foreach (var item in items)
                    {
                        <MudTd>@item</MudTd>
                    }
                </tr>
            }
        }
    </table>
}
