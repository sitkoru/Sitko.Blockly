@inherits BlocksList
<link rel="stylesheet" href="@MudBlazorEditorJSModule.CssUrl">
@foreach (var block in Blocks)
{
    var blockDescriptor = EditorJs.GetBlockDescriptor(block.GetType());
    var className = $"editorjs editorjs-{block.GetType().Name.ToLowerInvariant()} {blockDescriptor.DisplayComponentCssClass}";
    <div class="@className" @key="block.Id">
        @(RenderBlock(blockDescriptor, block))
    </div>
}
