<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sitko.Blockly.MudBlazor\Sitko.Blockly.MudBlazor.csproj"/>
    <ProjectReference Include="..\Sitko.Blockly.Data\Sitko.Blockly.Data.csproj"/>
  </ItemGroup>
  <ItemGroup>

    <PackageReference Include="Sitko.Core.Blazor.MudBlazor"/>
    <PackageReference Include="Sitko.Core.Blazor.Wasm"/>
    <PackageReference Include="Sitko.Core.Storage.Remote"/>
    <PackageReference Include="Sitko.Core.Repository.Remote.Wasm"/>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Components\"/>
    <Folder Include="wwwroot\js\"/>
  </ItemGroup>

</Project>
